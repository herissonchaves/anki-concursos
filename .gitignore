# Gerados pelo comando de teste com uv
.venv/
uv.lock
.pytest_cache/
__pycache__/

# Entregáveis para importar no Anki: o usuário esvazia a pasta depois de importar
output/

# Pacotes exportados dos lotes: regeneráveis a partir de lotes/*/*/lote/
lotes/**/*.zip
lotes/**/*.apkg
# Backups do Anki nunca entram no repositório
*.colpkg
# Prévia visual dos cards: regenerada pelo fonte/gerar_lote.py de cada lote
lotes/**/previa_cards.html

# Pacotes para outras plataformas (ex.: ChatGPT), regeneráveis a partir de skills/
dist/

# Assinatura local do índice do banco de referências (muda a cada máquina)
referencias/.estado_indice
